{
  "name": "forgecanary",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit && tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run",
    "build:ui": "vite build",
    "dev:ui": "vite",
    "demo": "npm run build:ui && tsx src/demo-stack.ts",
    "fixture:v1": "tsx src/fixture-server.ts --version v1 --port 9101 --state .data/v1-state.json --adapter .data/adapter.json",
    "fixture:v2": "tsx src/fixture-server.ts --version v2 --port 9102 --state .data/v2-state.json --adapter .data/adapter.json",
    "adapter": "tsx src/adapter-control-server.ts --port 9200 --adapter .data/adapter.json",
    "model": "tsx src/model-server.ts",
    "trueforge": "SQLITE_PATH=.data/trueforge.sqlite trueforge --port 8790",
    "smoke": "tsx src/smoke.ts",
    "replay": "tsx src/replay.ts",
    "approval": "tsx src/approval.ts",
    "repeat": "tsx src/repeat.ts",
    "app": "npm run build:ui && tsx src/evidence-server.ts --port 9300"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.1.1",
    "@truefoundry/trueforge-sdk": "0.1.3",
    "@types/three": "^0.185.4",
    "class-variance-authority": "^0.7.1",
    "postprocessing": "^6.39.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadow-plugin": "^2.1.0",
    "three": "^0.185.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.2.1",
    "@truefoundry/trueforge": "0.1.4",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "tailwindcss": "4.2.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "^7.3.6",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.14"
  }
}
